# Global Environment Configuration
# SR University - Weather-Based Agricultural Advisory Platform (2026-2027)

# Server Ports
PORT=5000
FRONTEND_PORT=3000

# Backend & Environment
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/agroadvisory
JWT_SECRET=super_secret_agricultural_advisory_jwt_key_2026_sr_university
JWT_EXPIRES_IN=7d

# Live OpenWeatherMap API Integration
# Sign up free at https://openweathermap.org/api to get your 32-character key
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Default Regional Agriculture Parameters
DEFAULT_LOCATION_CITY=Warangal
DEFAULT_LOCATION_STATE=Telangana
DEFAULT_LOCATION_COUNTRY=IN

# Security & CORS
RATE_LIMIT_MAX=500
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
